# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# EXCEPTION: certs/cpcb-caaqms-chain.pem is PUBLIC certificates (CPCB's TLS
# chain — trust anchors, not keys; see certs/README.md). The *.pem rule above
# exists for private keys and silently swallowed this file out of the commit
# that introduced it, which shipped a test reading a file that was not there.
# A negation is the only way a regeneration cannot silently drop it again.
!certs/cpcb-caaqms-chain.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents every variable and holds no values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Self-contained design review builds — generated, multi-MB base64 payloads.
# Regenerate from public/design/ rather than committing.
docs/design/*.html
# Unused originals from the supplied photo library; only the images actually
# referenced by a page are committed.
public/design/img/lib/

# design working files that are regenerable or too heavy for git
# self-contained review builds inline every photograph as base64 — 55MB and
# rebuildable from public/design/*.html at any time, so they stay local
/docs/design/*.html
# scratch drop folder for files handed over by the owner
/incoming/
# screenshot scaffolding
/public/design/_w/
.gstack/

# design working screenshots — 147MB of review captures, not source
docs/design/img/

# The local before/after viewer (public/_compare/) is a scratch tool: it holds a
# copy of the pre-AD-29 built pages so both versions can be compared side by side
# in real viewports. It is NOT covered by next.config's noindex rules, so it must
# never reach a deploy. Regenerate it with:
#   git archive <commit> public/_pages/v3 | tar -x -C public/_compare/before --strip-components=3
public/_compare/

# Agent worktrees. These are full checkouts — one abandoned pair came to 1.9 GB
# (28 August 2026), and one of them held an uncommitted fix nobody had landed.
# The rule was previously only in .git/info/exclude, which is local-only and so
# protected exactly one machine. `git worktree list` is the way to find them;
# .claude/launch.json stays tracked.
.claude/worktrees/
