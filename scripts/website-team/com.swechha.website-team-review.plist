<?xml version="1.0" encoding="UTF-8"?>
<!--
  Weekly review, Mondays.

  Install both:
      cp scripts/website-team/com.swechha.website-team-*.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.swechha.website-team-work.plist
      launchctl load ~/Library/LaunchAgents/com.swechha.website-team-review.plist

  launchd uses LOCAL time, not UTC — unlike GitHub Actions cron, which is the
  trap recorded in the farm app's notes. 10:00 here is 10:00 IST.

  It does not fire while the Mac is asleep. A missed run happens at the next
  wake, which is fine for a daily review pass and would not be for anything
  time-critical.

  MONDAY AT 10:00, NOT 09:00, AND THAT HOUR IS LOAD-BEARING. Both schedules
  used to say 09:00, so on Mondays this run and the daily `work` run started in
  the same second, in one shared worktree, one of them checking out a branch
  while the other read the tree. run.sh takes a lock and the second would now
  wait rather than corrupt the first — but a lock that is hit every Monday is a
  design relying on its own backstop. The hour apart means the lock stays what
  it should be: the thing that never fires.
-->
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.swechha.website-team-review</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/swechha-website/scripts/website-team/run.sh review</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
  <key>Weekday</key><integer>1</integer>
    <key>Hour</key>             <integer>10</integer>
    <key>Minute</key>           <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>    <string>/tmp/swechha-website-team-review.log</string>
  <key>StandardErrorPath</key>  <string>/tmp/swechha-website-team-review.err</string>
  <key>RunAtLoad</key>          <false/>
</dict>
</plist>
