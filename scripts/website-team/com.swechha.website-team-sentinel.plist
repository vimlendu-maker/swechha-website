<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.swechha.website-team-sentinel</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>${SWECHHA_AI_REPO:-$HOME/swechha-ai}/sentinel.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>1800</integer>
	<key>StandardOutPath</key>
	<string>/tmp/swechha-website-team-sentinel.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/swechha-website-team-sentinel.err</string>
	<key>RunAtLoad</key>
	<false/>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- The job names itself to the event stream. org/status.py joins
		     observed runs to scheduled jobs; with only a department to join
		     on, two jobs in one department both read `ok` when either ran.
		     Declared HERE so the string launchd registers as Label and the
		     string that reaches the event are the same string. -->
		<key>ORG_JOB_LABEL</key>
		<string>com.swechha.website-team-sentinel</string>
	</dict>
</dict>
</plist>
