<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs the department WITHIN SECONDS of the owner saving a job in Obsidian.

  WatchPaths fires whenever the named file is written. Obsidian writes while
  you type and the Git plugin writes when it commits, so on-change.sh compares
  a hash of the `## Open` section and does nothing unless the open jobs
  actually changed — otherwise every keystroke-pause would cost about $0.80.

  This is the answer to "if I get an idea now, does it wait until tomorrow?".
  It does not. It waits about as long as Obsidian takes to save.

  launchd does not fire while the Mac is asleep; a job saved on a sleeping
  machine runs at wake.
-->
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.swechha.website-team-oninbox</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/swechha-website/scripts/website-team/on-change.sh</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>/Users/administrator/swechha-vault/swechha/website/team/inbox.md</string>
    <string>/Users/administrator/swechha-vault/swechha/ai/inbox.md</string>
  </array>
  <key>StandardOutPath</key>    <string>/tmp/swechha-website-team-oninbox.log</string>
  <key>StandardErrorPath</key>  <string>/tmp/swechha-website-team-oninbox.err</string>
  <key>RunAtLoad</key>          <false/>
</dict>
</plist>
