{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "chore/**": false,
      "ci/**": false,
      "claude/**": false,
      "docs/**": false,
      "feat/**": false,
      "fix/**": false,
      "refactor/**": false,
      "team/**": false,
      "test/**": false,
      "preview/**": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/air",
      "schedule": "17 1 * * *"
    }
  ]
}
