# Copy to .env.local and fill in. .env* is gitignored — never commit a real key.
#
# NOTHING HERE IS EVER EXPOSED TO THE BROWSER. There is no NEXT_PUBLIC_ variable
# in this file on purpose: the whole reason /api/air and /api/ward exist as
# server routes is so the CPCB key stays server-side. If you ever find yourself
# adding NEXT_PUBLIC_ to one of these, the answer is a route, not a prefix.

# ─── The air reading. Required for the LIVE badge and the ward picker. ───────
# Register at https://data.gov.in/ and generate an API key.
# Without it: /api/air returns 503, the page keeps its committed reading and
# the badge stays PERIODIC. That is a designed state, not a break.
DATA_GOV_IN_KEY=

# ─── Watch your ward. Required only for the subscription. ────────────────────
# Neon Postgres (https://neon.tech). Neon rather than Supabase because
# Supabase's free tier PAUSES after a week of inactivity, which would silently
# kill the hourly alert job.
# Create the schema once:  psql "$DATABASE_URL" -f db/001-ward-subscriptions.sql
DATABASE_URL=

# Resend (https://resend.com) for the confirmation and alert emails. Used via
# its plain HTTPS API — no SDK.
RESEND_API_KEY=

# Optional. Defaults shown.
# WARD_MAIL_FROM="Swechha air <air@swechha.in>"

# ─── The monthly digest. Same two secrets, a SECOND table. ───────────────────
# ★ RUN THIS OR THE FORM STAYS HONEST-BUT-BROKEN. The subscribe box on /now,
# /stories and the five situation pages posts to /api/newsletter/subscribe,
# which needs a table that db/001 does not create. Until it exists the endpoint
# answers 503 and the form prints what is missing — it will not silently
# swallow an address — but nobody can actually subscribe:
#   npm run db:migrate          (applies every db/*.sql; safe to re-run)
#
# There is no psql on the development machine (no Homebrew), so the
# `psql "$DATABASE_URL" -f …` line above db/001 never actually ran anywhere.
# scripts/db-migrate.mjs applies the same files through the Neon driver the app
# already depends on. `vercel env pull` will NOT supply DATABASE_URL — it is a
# SENSITIVE variable and the pull writes the literal string "[SENSITIVE]" —
# so take the connection string from the Neon dashboard:
#   DATABASE_URL='postgresql://…' npm run db:migrate
# or paste db/002 straight into Neon's SQL Editor.
#
# A separate table, not a row in ward_subscriptions: that table's `station` is
# NOT NULL and its alert job selects confirmed rows BY station, so a digest row
# with a sentinel station would eventually be sent hourly air alerts. See the
# comment at the top of db/002.
#
# Optional. Defaults shown. Deliberately NOT the ward's air@ sender: a reader
# who filters or blocks one list must not lose the other, and the From line is
# what they filter on.
# DIGEST_MAIL_FROM="Swechha <hello@swechha.in>"

# ─── Deploy state. Both optional; the defaults are the SAFE ones. ────────────
# SITE_ORIGIN is this deployment's own origin. It feeds the sitemap, robots.txt,
# metadataBase, structured data and the links inside ward emails. Unset, Vercel's
# own VERCEL_URL is used, and failing that the production domain — so a preview
# deploy describes itself instead of advertising the live WordPress site.
# SITE_ORIGIN=https://swechha.in
#
# SITE_INDEXABLE opens the site to search engines. UNSET MEANS CLOSED: robots.txt
# serves `Disallow: /` and every response carries `X-Robots-Tag: noindex`. Set it
# to exactly `true` on the deployment that owns the real domain, and nowhere else
# — an indexed preview URL competes with the real one and takes months to clear.
# `/_pages/*` stays noindex either way: those files are the built HTML the rewrite
# layer serves, and each already answers at a canonical route.
# SITE_INDEXABLE=true

# ─── Local data refresh only — the fetch scripts, never the app. ────────────
# These write committed JSON into data/. They are not read at runtime.
# WAQI_TOKEN=          # https://aqicn.org/data-platform/token/  (cross-check + forecast)
# FIRMS_MAP_KEY=       # https://firms.modaps.eosdis.nasa.gov/api/map_key/  (farm fires)
