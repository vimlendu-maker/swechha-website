ight=\"1080\" width=\"1920\" alt=\"\" class=\"slider-7277 slide-7316 msDefaultImage lazyload\" src=\"data:image\/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==\" style=\"--smush-placeholder-width: 1920px; --smush-placeholder-aspect-ratio: 1920\/1080;\" \/><\/li>\n                <li style=\"display: none; width: 100%;\" class=\"slide-7317 ms-image \" aria-roledescription=\"slide\" data-date=\"2017-01-17 09:29:52\" data-filename=\"11119007_10152823488867896_2124202588448254745_n-960x540.jpg\" data-slide-type=\"image\"><img decoding=\"async\" data-src=\"https:\/\/swechha.in\/wp-content\/uploads\/2017\/01\/11119007_10152823488867896_2124202588448254745_n-960x540.jpg\" height=\"1080\" width=\"1920\" alt=\"\" class=\"slider-7277 slide-7317 msDefaultImage lazyload\" src=\"data:image\/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==\" style=\"--smush-placeholder-width: 1920px; --smush-placeholder-aspect-ratio: 1920\/1080;\" \/><\/li>\n                <li style=\"display: none; width: 100%;\" class=\"slide-7318 ms-image \" aria-roledescription=\"slide\" data-date=\"2017-01-17 09:29:56\" data-filename=\"11140350_10152823489227896_3754166713593041876_n-960x540.jpg\" data-slide-type=\"image\"><img decoding=\"async\" data-src=\"https:\/\/swechha.in\/wp-content\/uploads\/2017\/01\/11140350_10152823489227896_3754166713593041876_n-960x540.jpg\" height=\"1080\" width=\"1920\" alt=\"\" class=\"slider-7277 slide-7318 msDefaultImage lazyload\" src=\"data:image\/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==\" style=\"--smush-placeholder-width: 1920px; --smush-placeholder-aspect-ratio: 1920\/1080;\" \/><\/li>\n                <li style=\"display: none; width: 100%;\" class=\"slide-7319 ms-image \" aria-roledescription=\"slide\" data-date=\"2017-01-17 09:30:07\" data-filename=\"11167702_10152823489207896_2817701817564849204_n-960x540.jpg\" data-slide-type=\"image\"><img decoding=\"async\" data-src=\"https:\/\/swechha.in\/wp-content\/uploads\/2017\/01\/11167702_10152823489207896_2817701817564849204_n-960x540.jpg\" height=\"1080\" width=\"1920\" alt=\"\" class=\"slider-7277 slide-7319 msDefaultImage lazyload\" src=\"data:image\/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjwvc3ZnPg==\" style=\"--smush-placeholder-width: 1920px; --smush-placeholder-aspect-ratio: 1920\/1080;\" \/><\/li>\n            <\/ul>\n        <\/div>\n        \n    <\/div>\n<\/div>\n<h5><span style=\"color: #333333;\">Azaad\u00a0Pinjrey\u00a0is a traveling show with elements of street theatre, poetry and puppetry. Through the show, 41 children and adolescents (aged 7-18) from Jagdamba Camp, creatively express their \u201cfreedom to be.\u201dThese are inspired from real life situations that portray the society\u2019s warped idea of freedom; one that silently perpetrates oppression and forces acceptance of all that is\u00a0anti-freedom. \u00a0<\/span><\/h5>\n<h5><span style=\"color: #333333;\">This is a story of hope, of swimming against the current and claiming the right to be free. In this 25 minute performance, 3 short stories will weave themselves together into one uniquedastaan\u00a0of the oppressor, the oppressed, the spectator and the hero. \u00a0<\/span><\/h5>\n<h5><span style=\"color: #333333;\"> Date:<\/span><\/h5>\n<h5><span style=\"color: #333333;\">Venue:<\/span><\/h5>\n<h5><span style=\"color: #333333;\">Time:<\/span><\/h5>\n<\/div>\n<div id=\"cmsms_divider_6a8ab9c6cdbf2\" class=\"cl\"><\/div>\n<div id=\"cmsms_button_6a8ab9c6cdc0d\" class=\"button_wrap\"><a href=\"#\" class=\"cmsms_button\"><span>RSVP<\/span><\/a><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n\n","protected":false},"excerpt":{"rendered":"","protected":false}},{"id":5707,"date":"2015-03-24T13:20:11","modified":"2015-07-26T14:10:15","slug":"spotted-stop-it","link":"https:\/\/swechha.in\/spotted-stop-it\/","title":{"rendered":"Spotted. Stop It!"},"content":{"rendered":"<style type=\"text\/css\"> \n#cmsms_row_6a8ab9c6ce7d4 .cmsms_row_outer_parent { \n\tpadding-top: 0px; \n} \n\n#cmsms_row_6a8ab9c6ce7d4 .cmsms_row_outer_parent { \n\tpadding-bottom: 50px; \n} \n\n<\/style><div id=\"cmsms_row_6a8ab9c6ce7d4\" class=\"cmsms_row cmsms_color_scheme_default\">\n<div class=\"cmsms_row_outer_parent\">\n<div class=\"cmsms_row_outer\">\n<div class=\"cmsms_row_inner\">\n<div class=\"cmsms_row_margin\">\n<div class=\"cmsms_column one_first\">\n<div class=\"cmsms_text\">\n<h5><span style=\"color: #333333;\">Spotted is Swechha\u2019s annual city-level socio-environmental campaign initiated to expose the menace of urban waste and to inspire citizens and government to act against it. Spearheaded by youth volunteers from diverse backgrounds, the campaign aims to instill environmental consciousness in people, promote responsible consumerism, offer practical green solutions to the problem of waste and put pressure on government agencies for effective waste management.\u00a0\u00a0<\/span><\/h5>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n\n","protected":false},"excerpt":{"rendered":"","protected":false}},{"id":5705,"date":"2015-03-24T13:16:14","modified":"2015-07-26T14:10:15","slug":"cyclothon-2012","link":"https:\/\/swechha.in\/cyclothon-2012\/","title":{"rendered":"Cyclothon 2012"},"content":{"rendered":"<style type=\"text\/css\"> \n#cmsms_row_6a8ab9c6ceea7 .cmsms_row_outer_parent { \n\tpadding-top: 0px; \n} \n\n#cmsms_row_6a8ab9c6ceea7 .cmsms_row_outer_parent { \n\tpadding-bottom: 50px; \n} \n\n \n#cmsms_divider_6a8ab9c6cf034 { \n\tpadding-top:50px; \n\tmargin-bottom:50px; \n} \n\n#cmsms_button_6a8ab9c6cf051 { \n\ttext-align:center; \n} \n\n#cmsms_button_6a8ab9c6cf051 .cmsms_button:before { \n\tmargin-right:.5em; \n\tmargin-left:0; \n\tvertical-align:baseline; \n} \n\n#cmsms_button_6a8ab9c6cf051 .cmsms_button { \n\tfont-weight:100; \n\tfont-style:normal; \n\tborder-style:solid; \n} \n#cmsms_button_6a8ab9c6cf051 .cmsms_button:hover { \n} \n<\/style><div id=\"cmsms_row_6a8ab9c6ceea7\" class=\"cmsms_row cmsms_color_scheme_default\">\n<div class=\"cmsms_row_outer_parent\">\n<div class=\"cmsms_row_outer\">\n<div class=\"cmsms_row_inner\">\n<div class=\"cmsms_row_margin\">\n<div class=\"cmsms_column one_first\">\n<div class=\"cmsms_text\">\n<h5><span style=\"color: #333333;\">The Yamuna Cyclothon gathers hundreds of likeminded individuals who come together as environmentally conscious citizens and cycle to express solidarity with the Yamuna. The event promotes the idea of volunteering for a better planet. Yamuna Cyclothon sensitizes participants towards issues surrounding the Yamuna and demonstrates the importance of cycling, recycling and upcycling as healthy environmental choices.<\/span><\/h5>\n<h5><span style=\"color: #333333;\">Date:<\/span><\/h5>\n<h5><span style=\"color: #333333;\">Venue:<\/span><\/h5>\n<h5><span style=\"color: #333333;\">Time:<\/span><\/h5>\n<\/div>\n<div id=\"cmsms_divider_6a8ab9c6cf034\" class=\"cmsms_divider solid\"><\/div>\n\n<div id=\"cmsms_button_6a8ab9c6cf051\" class=\"button_wrap\"><a href=\"#\" class=\"cmsms_button\"><span>RSVP<\/span><\/a><\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n\n","protected":false},"excerpt":{"rendered":"","protected":false}},{"id":5378,"date":"2015-03-19T12:12:46","modified":"2015-07-26T14:10:15","slug":"upcycle-and-upscale","link":"https:\/\/swechha.in\/upcycle-and-upscale\/","title":{"rendered":"Upcycle and upscale"},"content":{"rendered":"<style type=\"text\/css\"><\/style>","protected":false},"excerpt":{"rendered":"","protected":false}},{"id":5376,"date":"2015-03-19T10:38:25","modified":"2015-07-26T14:10:15","slug":"and-a-forest-is-born","link":"https:\/\/swechha.in\/and-a-forest-is-born\/","title":{"rendered":"And a FOREST is born\u2026"},"content":{"rendered":"<style type=\"text\/css\"><\/style>","protect