{
  "name": "swechha-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:situation-air": "node scripts/build-situation-air.mjs",
    "build:situation-yamuna": "node scripts/build-situation-yamuna.mjs",
    "build:situation-heatwave": "node scripts/build-situation-heatwave.mjs",
    "build:situation-forest-fire": "node scripts/build-situation-forest-fire.mjs",
    "build:situation-forest-loss": "node scripts/build-situation-forest-loss.mjs",
    "build:situation-climate-event": "node scripts/build-situation-climate-event.mjs",
    "build:air-india": "node scripts/build-air-india.mjs",
    "build:index": "node scripts/build-intelligence.mjs",
    "build:about": "node scripts/build-about-page.mjs",
    "build:situations": "npm run build:situation-air && npm run build:air-india && npm run build:situation-yamuna && npm run build:situation-heatwave && npm run build:situation-forest-fire && npm run build:situation-forest-loss && npm run build:situation-climate-event && npm run build:index",
    "verify:final": "node scripts/verify-final.mjs",
    "verify:crosscheck": "node scripts/verify-air-crosscheck.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "new:situation": "node scripts/new-situation.mjs",
    "build:work": "node scripts/build-work-pages.mjs",
    "data:air:delhi": "node scripts/fetch-air.mjs",
    "data:air:india": "node scripts/fetch-india.mjs",
    "data:air": "npm run data:air:delhi && npm run data:air:india",
    "data:air-all": "node scripts/fetch-air.mjs && node scripts/fetch-india.mjs && node scripts/fetch-crosscheck.mjs && node scripts/fetch-fires.mjs && node scripts/fetch-coverage.mjs && node scripts/fetch-attention.mjs",
    "ward:dry": "node scripts/ward-alerts.mjs --dry-run",
    "data:yamuna": "node scripts/fetch-yamuna.mjs && node scripts/fetch-rivers-india.mjs",
    "data:heat": "node scripts/fetch-heat-india.mjs && node scripts/fetch-bhuvan-heat.mjs",
    "data:climate": "node scripts/fetch-climate-india.mjs",
    "data:forest": "node scripts/fetch-gfw-india.mjs && node scripts/fetch-forest-loss.mjs",
    "data:forest-fire": "node scripts/fetch-forest-fire.mjs",
    "data:attention": "WIKI_ARTICLE=Yamuna node scripts/fetch-attention.mjs data/attention-yamuna.json && WIKI_ARTICLE=Heat_wave node scripts/fetch-attention.mjs data/attention-heatwave.json && WIKI_ARTICLE=Deforestation_in_India node scripts/fetch-attention.mjs data/attention-forest-loss.json && WIKI_ARTICLE=Climate_change_in_India node scripts/fetch-attention.mjs data/attention-climate-event.json",
    "data:coverage": "node scripts/refresh-coverage.mjs",
    "data:situations": "npm run data:yamuna && npm run data:heat && npm run data:climate && npm run data:forest && npm run data:forest-fire && npm run data:attention && npm run data:coverage",
    "watch:documents": "node scripts/watch-documents.mjs",
    "watch:documents:strict": "node scripts/watch-documents.mjs --strict",
    "build:impact": "node scripts/build-impact-page.mjs",
    "build:farm": "node scripts/build-farm-page.mjs",
    "build:act": "node scripts/build-act-page.mjs",
    "build:stories": "node scripts/build-stories-page.mjs",
    "build:publications": "node scripts/build-publications-page.mjs",
    "build:posters": "node scripts/build-posters-page.mjs",
    "build:hero": "node scripts/build-hero.mjs",
    "build:hero:check": "node scripts/build-hero.mjs --check",
    "keys": "node --env-file-if-exists=.env.local scripts/keys-check.mjs",
    "keys:live": "node --env-file-if-exists=.env.local scripts/keys-check.mjs --live --github",
    "build:search": "node scripts/build-search-page.mjs",
    "build:essays": "node scripts/build-essays.mjs",
    "db:migrate": "node --env-file-if-exists=.env.migrate.local --env-file-if-exists=.env.local scripts/db-migrate.mjs"
  },
  "dependencies": {
    "@keystatic/core": "^0.6.8",
    "@keystatic/next": "^5.0.5",
    "@neondatabase/serverless": "^1.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.9",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^59.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
